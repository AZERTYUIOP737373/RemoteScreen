
import asyncio
import io
import json
import threading
import time

import mss
from PIL import Image
import websockets
import pyautogui


SERVER_URL = "wss://wage-cancer-volume-scheduled.trycloudflare.com/agent"

FPS = 30
JPEG_QUALITY = 55

MONITOR_NUMBER = 1

MAX_SIZE = 8 * 1024 * 1024

RECONNECT_DELAY = 3

CONTROL_TOKEN = "CHANGE-ME-REMOTE-SCREEN-2026"


running = True

websocket = None

network_loop_instance = None


pyautogui.PAUSE = 0
pyautogui.FAILSAFE = False


def set_status(text):
    print("[Agent]", text)


def clamp(value, minimum, maximum):
    return max(
        minimum,
        min(
            value,
            maximum
        )
    )


def normalize_key(key):

    if not isinstance(key, str):
        return None

    key = key.lower()

    key_map = {

        "return": "enter",
        "backspace": "backspace",
        "tab": "tab",
        "escape": "esc",
        "space": "space",

        "shift": "shift",
        "shift_l": "shift",
        "shift_r": "shift",

        "control": "ctrl",
        "control_l": "ctrl",
        "control_r": "ctrl",

        "alt": "alt",
        "alt_l": "alt",
        "alt_r": "alt",

        "win": "win",
        "super": "win",
        "super_l": "win",
        "super_r": "win",

        "left": "left",
        "right": "right",
        "up": "up",
        "down": "down",

        "home": "home",
        "end": "end",
        "prior": "pageup",
        "next": "pagedown",

        "insert": "insert",
        "delete": "delete",

        "caps_lock": "capslock",
        "num_lock": "numlock",
        "scroll_lock": "scrolllock",

        "f1": "f1",
        "f2": "f2",
        "f3": "f3",
        "f4": "f4",
        "f5": "f5",
        "f6": "f6",
        "f7": "f7",
        "f8": "f8",
        "f9": "f9",
        "f10": "f10",
        "f11": "f11",
        "f12": "f12",

        "comma": ",",
        "period": ".",
        "slash": "/",
        "backslash": "\\",
        "semicolon": ";",
        "apostrophe": "'",
        "bracketleft": "[",
        "bracketright": "]",
        "minus": "-",
        "equal": "=",
        "grave": "`",
    }

    if key in key_map:
        return key_map[key]

    if len(key) == 1:
        return key

    return None


def handle_control_command(data):

    if not isinstance(data, dict):
        return

    token = data.get("token")

    if token != CONTROL_TOKEN:

        print(
            "[Agent] Commande refusée : token invalide."
        )

        return

    command_type = data.get("type")

    try:

        screen_width, screen_height = pyautogui.size()

        if command_type == "mouse_move":

            x = clamp(
                int(data["x"]),
                0,
                screen_width - 1
            )

            y = clamp(
                int(data["y"]),
                0,
                screen_height - 1
            )

            pyautogui.moveTo(
                x,
                y,
                duration=0
            )

            return

        elif command_type == "left_down":

            pyautogui.mouseDown(
                button="left"
            )

            return

        elif command_type == "left_up":

            pyautogui.mouseUp(
                button="left"
            )

            return

        elif command_type == "right_down":

            pyautogui.mouseDown(
                button="right"
            )

            return

        elif command_type == "right_up":

            pyautogui.mouseUp(
                button="right"
            )

            return

        elif command_type == "left_click":

            pyautogui.click(
                button="left"
            )

            return

        elif command_type == "right_click":

            pyautogui.click(
                button="right"
            )

            return

        elif command_type == "scroll":

            amount = int(
                data.get(
                    "amount",
                    0
                )
            )

            amount = clamp(
                amount,
                -20,
                20
            )

            pyautogui.scroll(
                amount
            )

            return

        elif command_type == "key_down":

            key = normalize_key(
                data.get("key")
            )

            if key is None:

                print(
                    "[Agent] Touche inconnue :",
                    data.get("key")
                )

                return

            pyautogui.keyDown(
                key
            )

            return

        elif command_type == "key_up":

            key = normalize_key(
                data.get("key")
            )

            if key is None:

                print(
                    "[Agent] Touche inconnue :",
                    data.get("key")
                )

                return

            pyautogui.keyUp(
                key
            )

            return

        else:

            print(
                "[Agent] Commande inconnue :",
                command_type
            )

    except Exception as exc:

        print(
            "[Agent] Erreur commande :",
            exc
        )


async def receive_controls(ws):

    global running

    while running:

        try:

            message = await ws.recv()

            if not isinstance(
                message,
                str
            ):
                continue

            try:

                data = json.loads(
                    message
                )

            except json.JSONDecodeError:

                print(
                    "[Agent] Message non JSON reçu."
                )

                continue

            handle_control_command(
                data
            )

        except websockets.exceptions.ConnectionClosed:

            print(
                "[Agent] Connexion fermée pendant la réception."
            )

            break

        except asyncio.CancelledError:

            break

        except Exception as exc:

            print(
                "[Agent] Erreur réception commande :",
                exc
            )

            await asyncio.sleep(
                0.05
            )


async def send_screen(ws):

    global running

    frame_delay = 1.0 / FPS
    next_frame_time = time.perf_counter()

    try:

        with mss.mss() as sct:

            monitors = sct.monitors

            if len(monitors) <= MONITOR_NUMBER:

                print(
                    "[Agent] Moniteur introuvable."
                )

                return

            monitor = monitors[
                MONITOR_NUMBER
            ]

            print(
                "[Agent] Écran utilisé :",
                MONITOR_NUMBER
            )

            print(
                "[Agent] Résolution :",
                monitor["width"],
                "x",
                monitor["height"]
            )

            frame_count = 0
            fps_start = time.perf_counter()

            while running:

                try:

                    screenshot = sct.grab(
                        monitor
                    )

                    image = Image.frombuffer(
                        "RGB",
                        screenshot.size,
                        screenshot.rgb,
                        "raw",
                        "RGB",
                        0,
                        1
                    )

                    buffer = io.BytesIO()

                    image.save(
                        buffer,
                        format="JPEG",
                        quality=JPEG_QUALITY
                    )

                    payload = buffer.getvalue()

                    if len(payload) <= MAX_SIZE:

                        await ws.send(
                            payload
                        )

                        frame_count += 1

                    else:

                        print(
                            "[Agent] Image trop volumineuse :",
                            len(payload),
                            "octets"
                        )

                except websockets.exceptions.ConnectionClosed:

                    print(
                        "[Agent] WebSocket fermé."
                    )

                    break

                except asyncio.CancelledError:

                    break

                except Exception as exc:

                    print(
                        "[Agent] Erreur capture :",
                        exc
                    )

                    await asyncio.sleep(
                        0.1
                    )

                next_frame_time += frame_delay

                sleep_time = (
                    next_frame_time
                    -
                    time.perf_counter()
                )

                if sleep_time > 0:

                    await asyncio.sleep(
                        sleep_time
                    )

                else:

                    next_frame_time = time.perf_counter()

                current_time = time.perf_counter()

                if current_time - fps_start >= 5:

                    real_fps = (
                        frame_count
                        /
                        (current_time - fps_start)
                    )

                    print(
                        "[Agent] FPS réel :",
                        round(real_fps, 1)
                    )

                    frame_count = 0
                    fps_start = current_time

    except asyncio.CancelledError:

        pass

    except Exception as exc:

        print(
            "[Agent] Erreur écran :",
            exc
        )


async def network_loop():

    global running
    global websocket
    global network_loop_instance

    network_loop_instance = (
        asyncio.get_running_loop()
    )

    while running:

        try:

            set_status(
                "Connexion au serveur..."
            )

            print(
                "[Agent] Connexion à :",
                SERVER_URL
            )

            async with websockets.connect(
                SERVER_URL,
                max_size=MAX_SIZE,
                ping_interval=20,
                ping_timeout=20,
                close_timeout=5
            ) as ws:

                websocket = ws

                set_status(
                    "Connecté — partage + souris + clavier"
                )

                print(
                    "[Agent] Connexion réussie."
                )

                screen_task = asyncio.create_task(
                    send_screen(
                        ws
                    )
                )

                control_task = asyncio.create_task(
                    receive_controls(
                        ws
                    )
                )

                done, pending = await asyncio.wait(
                    [
                        screen_task,
                        control_task
                    ],
                    return_when=asyncio.FIRST_COMPLETED
                )

                for task in pending:

                    task.cancel()

                await asyncio.gather(
                    *pending,
                    return_exceptions=True
                )

                websocket = None

        except websockets.exceptions.InvalidStatus as exc:

            websocket = None

            if running:

                print(
                    "[Agent] Connexion refusée :",
                    exc
                )

                await asyncio.sleep(
                    RECONNECT_DELAY
                )

        except websockets.exceptions.ConnectionClosed as exc:

            websocket = None

            if running:

                print(
                    "[Agent] Connexion fermée :",
                    exc
                )

                await asyncio.sleep(
                    RECONNECT_DELAY
                )

        except Exception as exc:

            websocket = None

            if running:

                print(
                    "[Agent] Erreur réseau :",
                    exc
                )

                await asyncio.sleep(
                    RECONNECT_DELAY
                )

    websocket = None

    print(
        "[Agent] Boucle réseau arrêtée."
    )


def start_network():

    try:

        asyncio.run(
            network_loop()
        )

    except Exception as exc:

        print(
            "[Agent] Erreur réseau générale :",
            exc
        )


if __name__ == "__main__":

    print()
    print("==============================================")
    print("            REMOTE SCREEN AGENT")
    print("==============================================")
    print()

    print(
        "Serveur :",
        SERVER_URL
    )

    print(
        "FPS cible :",
        FPS
    )

    print(
        "Qualité JPEG :",
        JPEG_QUALITY
    )

    print(
        "Écran :",
        MONITOR_NUMBER
    )

    print(
        "Contrôle souris : ACTIF"
    )

    print(
        "Contrôle clavier : ACTIF"
    )

    print()

    network_thread = threading.Thread(
        target=start_network,
        daemon=True
    )

    network_thread.start()

    try:

        while running:

            time.sleep(1)

    except KeyboardInterrupt:

        running = False

        print()
        print(
            "[Agent] Arrêt demandé."
        )

    finally:

        running = False

        print(
            "[Agent] Partage d'écran arrêté."
        )
